generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                        String              @id @default(cuid())
  fullName                  String
  username                  String              @unique
  password                  String
  role                      Role
  isActive                  Boolean             @default(true)
  createdAt                 DateTime            @default(now())
  updatedAt                 DateTime            @updatedAt
  lastLogin                 DateTime?
  phone                     String?
  createdJournalEntries     JournalEntry[]      @relation("JournalEntryCreatedBy")
  deletedJournalEntries     JournalEntry[]      @relation("JournalEntryDeletedBy")
  createdBilties            Bilty[]             @relation("BiltyCreatedBy")
  updatedBilties            Bilty[]             @relation("BiltyUpdatedBy")
  deletedBilties            Bilty[]             @relation("BiltyDeletedBy")
  createdChallans           Challan[]           @relation("ChallanCreatedBy")
  updatedChallans           Challan[]           @relation("ChallanUpdatedBy")
  deletedChallans           Challan[]           @relation("ChallanDeletedBy")
  settledChallans           Challan[]           @relation("ChallanSettledBy")
  createdSettlementPayments SettlementPayment[] @relation("SettlementPaymentCreatedBy")
  createdEmployees          Employee[]          @relation("EmployeeCreatedBy")
  deletedEmployees          Employee[]          @relation("EmployeeDeletedBy")
  createdPayslips           Payslip[]           @relation("PayslipCreatedBy")
  deletedPayslips           Payslip[]           @relation("PayslipDeletedBy")
  createdPhonches           Phonch[]            @relation("PhonchCreatedBy")
  updatedPhonches           Phonch[]            @relation("PhonchUpdatedBy")
  deletedPhonches           Phonch[]            @relation("PhonchDeletedBy")
  createdPrivatePhonches    PrivatePhonch[]     @relation("PrivatePhonchCreatedBy")
  updatedPrivatePhonches    PrivatePhonch[]     @relation("PrivatePhonchUpdatedBy")
  deletedPrivatePhonches    PrivatePhonch[]     @relation("PrivatePhonchDeletedBy")
  createdBills              Bill[]              @relation("BillCreatedBy")
  updatedBills              Bill[]              @relation("BillUpdatedBy")
  deletedBills              Bill[]              @relation("BillDeletedBy")
  updatedBusinessSettings   BusinessSettings[]  @relation("BusinessSettingsUpdatedBy")
}

model Party {
  id                     String          @id @default(cuid())
  partyName              String
  contactPerson          String?
  phone                  String?
  whatsapp               String?
  cnicNtn                String?
  address                String?
  openingBalance         Decimal         @default(0) @db.Decimal(15, 2)
  openingBalanceType     BalanceType?
  isActive               Boolean         @default(true)
  notes                  String?
  createdAt              DateTime        @default(now())
  updatedAt              DateTime        @updatedAt
  partyTypes             PartyType[]
  account                Account?
  consignorBilties       Bilty[]         @relation("BiltyConsignorParty")
  consigneeBilties       Bilty[]         @relation("BiltyConsigneeParty")
  clearingAgentBilties   Bilty[]         @relation("BiltyClearingAgentParty")
  paidResponsibleBilties Bilty[]         @relation("BiltyPaidResponsibleParty")
  agentBilties           Bilty[]         @relation("BiltyAgentParty")
  transporterChallans    Challan[]       @relation("ChallanTransporterParty")
  transporterPhonches    Phonch[]        @relation("PhonchTransporterParty")
  phonchVehicleLines     PhonchVehicle[] @relation("PhonchVehicleParty")

  transporterPrivatePhonches             PrivatePhonch[]        @relation("PrivatePhonchTransporterParty")
  privatePhonchVehicleClearingAgentLines PrivatePhonchVehicle[] @relation("PrivatePhonchVehicleClearingAgent")

  bills Bill[] @relation("BillClientParty")
}

// ============================================================
// EMPLOYEES & PAYROLL (Step 16)
//
// Deliberately NOT a Party - Employee is its own first-class
// accounting relationship (per the approved design), with its own
// 1:1 Account (category EMPLOYEE_PAYABLE, mirroring exactly how
// Party gets its own 1:1 Account via Account.partyId). This keeps
// Employees fully out of Receivable/Payable (which iterate
// Party.findMany() only) while still fully participating in
// General Ledger/Trial Balance/P&L/Cash Book, all of which are
// already source- and relation-agnostic (sum by accountId/
// accountType only).
//
// Payslip intentionally has NO separate "payment" table and NO
// direct JournalEntry foreign key - actual payments are ordinary
// JournalEntry/JournalLine rows tagged JournalLine.sourceType =
// "PAYSLIP", sourceId = this Payslip's id (the exact same
// convention already used for Bilty/Challan), so "paid amount" is
// always DERIVED from the real ledger, never a second, independently
// stored balance that could drift from it.
// ============================================================

model Employee {
  id            String    @id @default(cuid())
  employeeCode  String    @unique
  name          String
  designation   String?
  phone         String?
  joiningDate   DateTime?
  monthlySalary Decimal   @default(0) @db.Decimal(15, 2)
  isActive      Boolean   @default(true)
  notes         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  createdById   String?
  deletedAt     DateTime?
  deletedById   String?
  isDeleted     Boolean   @default(false)

  createdBy User?     @relation("EmployeeCreatedBy", fields: [createdById], references: [id])
  deletedBy User?     @relation("EmployeeDeletedBy", fields: [deletedById], references: [id])
  account   Account?
  payslips  Payslip[]

  @@index([isActive])
  @@index([isDeleted])
}

model Payslip {
  id           String    @id @default(cuid())
  payslipNo    String    @unique
  employeeId   String
  payrollMonth String
  payDate      DateTime
  grossPay     Decimal   @db.Decimal(15, 2)
  deduction    Decimal   @default(0) @db.Decimal(15, 2)
  netPay       Decimal   @db.Decimal(15, 2)
  contribution Decimal   @default(0) @db.Decimal(15, 2)
  notes        String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  createdById  String?
  deletedAt    DateTime?
  deletedById  String?
  isDeleted    Boolean   @default(false)

  employee  Employee @relation(fields: [employeeId], references: [id])
  createdBy User?    @relation("PayslipCreatedBy", fields: [createdById], references: [id])
  deletedBy User?    @relation("PayslipDeletedBy", fields: [deletedById], references: [id])

  @@unique([employeeId, payrollMonth])
  @@index([payrollMonth])
  @@index([employeeId])
}

model Account {
  id                 String              @id @default(cuid())
  accountName        String
  accountCode        String?             @unique
  accountType        AccountType
  category           AccountCategory
  description        String?
  isSystem           Boolean             @default(false)
  isActive           Boolean             @default(true)
  parentId           String?
  partyId            String?             @unique
  employeeId         String?             @unique
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  parent             Account?            @relation("AccountHierarchy", fields: [parentId], references: [id], onDelete: Restrict)
  children           Account[]           @relation("AccountHierarchy")
  party              Party?              @relation(fields: [partyId], references: [id])
  employee           Employee?           @relation(fields: [employeeId], references: [id])
  ledgerEntries      JournalLine[]
  settlementPayments SettlementPayment[]

  @@index([accountType])
  @@index([category])
  @@index([parentId])
}

model Location {
  id       String  @id @default(cuid())
  name     String  @unique
  isActive Boolean @default(true)

  fromBilties Bilty[] @relation("BiltyFromLocation")
  toBilties   Bilty[] @relation("BiltyToLocation")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Bilty {
  id      String   @id @default(cuid())
  biltyNo String   @unique
  date    DateTime

  // Locations
  fromLocationId String
  fromLocation   Location @relation("BiltyFromLocation", fields: [fromLocationId], references: [id], onDelete: Restrict)

  toLocationId String
  toLocation   Location @relation("BiltyToLocation", fields: [toLocationId], references: [id], onDelete: Restrict)

  // Consignor
  consignorPartyId String?
  consignorParty   Party?  @relation("BiltyConsignorParty", fields: [consignorPartyId], references: [id], onDelete: SetNull)
  consignorName    String
  consignorPhone   String?

  // Consignee
  consigneePartyId String?
  consigneeParty   Party?  @relation("BiltyConsigneeParty", fields: [consigneePartyId], references: [id], onDelete: SetNull)
  consigneeName    String
  consigneePhone   String?

  // Vehicle
  vehicleType        String?
  vehicleModel       String?
  vehicleColor       String?
  engineNumber       String?
  chassisNumber      String?
  registrationNumber String?

  // Clearing Agent / Delivery Point
  clearingAgentPartyId String?
  clearingAgentParty   Party?  @relation("BiltyClearingAgentParty", fields: [clearingAgentPartyId], references: [id], onDelete: SetNull)
  clearingAgentName    String?

  // Freight
  rent      Decimal @default(0) @db.Decimal(15, 2)
  insurance Decimal @default(0) @db.Decimal(15, 2)
  expense   Decimal @default(0) @db.Decimal(15, 2)
  total     Decimal @default(0) @db.Decimal(15, 2)
  advance   Decimal @default(0) @db.Decimal(15, 2)
  toPay     Decimal @default(0) @db.Decimal(15, 2)

  // Paid-amount ("advance") responsibility - which Party is
  // considered responsible for the Paid portion actually reaching
  // ANC. Explicit only when BOTH consignorParty and consigneeParty
  // have a valid account (never guessed); left null when only one
  // exists (auto-resolved on read from whichever exists) or when
  // neither exists (Paid remains recognized on the Bilty with no
  // Party attribution - never fabricated). See
  // lib/document-party-resolution.ts's resolveBiltyPaidResponsibleParty().
  paidResponsiblePartyId String?
  paidResponsibleParty   Party?  @relation("BiltyPaidResponsibleParty", fields: [paidResponsiblePartyId], references: [id], onDelete: SetNull)

  // Agent Commission
  agentPartyId     String?
  agentParty       Party?  @relation("BiltyAgentParty", fields: [agentPartyId], references: [id], onDelete: SetNull)
  agentCommission  Decimal @default(0) @db.Decimal(15, 2)
  agentDescription String?

  notes  String?
  status BiltyStatus @default(PENDING)

  // Bin
  isDeleted   Boolean   @default(false)
  deletedAt   DateTime?
  deletedById String?
  deletedBy   User?     @relation("BiltyDeletedBy", fields: [deletedById], references: [id], onDelete: SetNull)

  // Audit
  createdById String?
  createdBy   User?   @relation("BiltyCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  updatedById String?
  updatedBy   User?   @relation("BiltyUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)

  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  challanBilties     ChallanBilty[]
  settlementPayments SettlementPayment[]

  @@index([date])
  @@index([status])
  @@index([isDeleted, deletedAt])
  @@index([fromLocationId])
  @@index([toLocationId])
}

model JournalEntry {
  id                String             @id @default(cuid())
  entryDate         DateTime           @default(now())
  referenceType     String?
  referenceId       String?
  description       String?
  createdById       String?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  deletedAt         DateTime?
  deletedById       String?
  isDeleted         Boolean            @default(false)
  createdBy         User?              @relation("JournalEntryCreatedBy", fields: [createdById], references: [id])
  deletedBy         User?              @relation("JournalEntryDeletedBy", fields: [deletedById], references: [id])
  lines             JournalLine[]
  settledChallans   Challan[]          @relation("ChallanSettlement")
  settlementPayment SettlementPayment?

  @@index([entryDate])
  @@index([referenceType])
  @@index([referenceId])
  @@index([createdById])
  @@index([isDeleted])
  @@index([deletedById])
}

model JournalLine {
  id                 String              @id @default(cuid())
  journalEntryId     String
  accountId          String
  description        String?
  debit              Decimal             @default(0) @db.Decimal(15, 2)
  credit             Decimal             @default(0) @db.Decimal(15, 2)
  createdAt          DateTime            @default(now())
  sourceId           String?
  sourceNumber       String?
  sourceType         String?
  account            Account             @relation(fields: [accountId], references: [id])
  journalEntry       JournalEntry        @relation(fields: [journalEntryId], references: [id], onDelete: Cascade)
  paymentAllocations PaymentAllocation[]

  @@index([journalEntryId])
  @@index([accountId])
  @@index([sourceType])
  @@index([sourceId])
  @@index([sourceNumber])
}

// ============================================================
// PAYMENT ALLOCATION (Party Ledger 2.0, Step 2A)
//
// Strictly additive reporting/reconciliation layer over the
// EXISTING accounting model - never a second accounting system.
//
// A "payment" is never a new record: it is the Party-side
// JournalLine of an already-posted Daily Posting Cash/Bank <->
// Party movement (see lib/payment-allocation.ts for the exact
// qualifying shape). This table only records how much of that
// EXISTING, unmodified line's amount is considered applied to
// which outstanding Bilty/Challan - it never creates, reverses, or
// duplicates a JournalEntry/JournalLine, never touches
// debit/credit/sourceId on the original line, and is invisible to
// every existing P&L/Trial Balance/Receivable/Payable calculation.
//
// One journalLineId can have MANY rows (one payment split across
// several documents); one (targetSourceType, targetSourceId) can
// also appear in MANY rows (several payments applied to the same
// document over time) - deliberately NOT unique together.
// ============================================================
model PaymentAllocation {
  id               String      @id @default(cuid())
  journalLineId    String
  journalLine      JournalLine @relation(fields: [journalLineId], references: [id], onDelete: Cascade)
  // "BILTY" | "CHALLAN" - the same sourceType vocabulary
  // JournalLine already uses; not modeled as an enum here for the
  // same reason JournalLine.sourceType isn't (see that field).
  targetSourceType String
  targetSourceId   String
  allocatedAmount  Decimal     @db.Decimal(15, 2)
  createdAt        DateTime    @default(now())
  createdById      String?

  @@index([journalLineId])
  @@index([targetSourceType, targetSourceId])
}

// ============================================================
// SETTLEMENT PAYMENT (multi-payer / multi-collector engine)
//
// Strictly additive over the existing Settlement/reclassification
// architecture (lib/settlement-accounting.ts, lib/settlement-
// correction.ts) - never a second accounting system. Each row
// represents exactly ONE simultaneous, independently-identified
// (payer, amount) reclassification against one Bilty's Collection
// (Remaining To-Pay) or one Challan's Carrier Rent - replacing the
// old single-payer-per-component ceiling WITHOUT touching how a
// still-single-payer document is recognized/booked (that existing
// path, lib/settlement-accounting.ts's buildSettlementEntries, is
// untouched and keeps working exactly as before).
//
// Every row's accounting effect lives entirely in real, balanced
// JournalEntry/JournalLine records - this table is a pure lookup/
// index over that ledger (exactly like PaymentAllocation above),
// never a second source of truth for the amount itself. A row's own
// id is the ONLY thing used to find every JournalEntry that belongs
// to it (JournalLine.sourceType = "SETTLEMENT_PAYMENT", sourceId =
// this row's id) - never description text, never "latest JournalLine
// wins". See lib/settlement-payments.ts.
//
// component is "COLLECTION" (Bilty-level, biltyId required) or
// "CARRIER_RENT" (Challan-level, biltyId null) - the same string
// vocabulary lib/settlement-accounting.ts's SettlementComponent type
// already uses, not modeled as a Prisma enum for the same reason
// JournalLine.sourceType / PaymentAllocation.targetSourceType aren't.
// ============================================================
model SettlementPayment {
  id             String       @id @default(cuid())
  // Nullable: "PAID" (Bilty Paid-amount responsibility, see
  // lib/bilty-paid-verification.ts) is resolved independently of any
  // Challan/Settlement and may exist before a Bilty ever joins a
  // Challan. "COLLECTION" and "CARRIER_RENT" rows always set this -
  // both remain Settlement-gated exactly as before.
  challanId      String?
  challan        Challan?     @relation(fields: [challanId], references: [id], onDelete: Cascade)
  biltyId        String?
  bilty          Bilty?       @relation(fields: [biltyId], references: [id], onDelete: Cascade)
  component      String
  payerAccountId String
  payerAccount   Account      @relation(fields: [payerAccountId], references: [id], onDelete: Restrict)
  amount         Decimal      @db.Decimal(15, 2)
  journalEntryId String       @unique
  journalEntry   JournalEntry @relation(fields: [journalEntryId], references: [id], onDelete: Restrict)
  createdById    String?
  createdBy      User?        @relation("SettlementPaymentCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([challanId, component])
  @@index([biltyId, component])
  @@index([payerAccountId])
}

enum Role {
  SUPER_ADMIN
  MANAGER
  VIEWER
}

enum PartyType {
  CUSTOMER
  VENDOR
  BOTH
  TRANSPORTER
  CLEARING_AGENT
}

enum BalanceType {
  DEBIT
  CREDIT
}

enum AccountType {
  ASSET
  LIABILITY
  EQUITY
  INCOME
  EXPENSE
  PARTY
}

enum AccountCategory {
  CASH
  BANK
  RECEIVABLE
  PAYABLE
  OTHER_ASSET
  TRANSPORTER_PAYABLE
  DELIVERY_POINT_PAYABLE
  VENDOR_PAYABLE
  EMPLOYEE_PAYABLE
  OTHER_LIABILITY
  OWNER_CAPITAL
  OWNER_DRAWING
  OTHER_EQUITY
  BOOKING_INCOME
  DELIVERY_INCOME
  CARRIER_INCOME
  OTHER_INCOME
  CARRIER_RENT
  FUEL
  OFFICE_RENT
  SALARY
  ELECTRICITY
  TEA_REFRESHMENT
  REPAIR_MAINTENANCE
  OTHER_EXPENSE
  PARTY
}

enum BiltyStatus {
  PENDING
  IN_TRANSIT
  DELIVERED
  CANCELLED
}

enum ChallanStatus {
  IN_TRANSIT
  DELIVERED
  CANCELLED
}

model Challan {
  id          String        @id @default(cuid())
  challanNo   String        @unique
  loadingDate DateTime
  status      ChallanStatus @default(IN_TRANSIT)

  // Transporter / Driver
  transporterPartyId String?
  transporterParty   Party?  @relation("ChallanTransporterParty", fields: [transporterPartyId], references: [id], onDelete: SetNull)
  driverName         String?
  driverPhone        String?
  carrierNumber      String?

  // Financial
  carrierRent Decimal @default(0) @db.Decimal(15, 2)
  remarks     String?

  // Settlement
  isSettled                Boolean       @default(false)
  settledAt                DateTime?
  settledById              String?
  settledBy                User?         @relation("ChallanSettledBy", fields: [settledById], references: [id], onDelete: SetNull)
  settlementNotes          String?
  settlementJournalEntryId String?
  settlementJournalEntry   JournalEntry? @relation("ChallanSettlement", fields: [settlementJournalEntryId], references: [id], onDelete: SetNull)

  clearingAgentPaysDriver Boolean @default(false)
  commissionRecoveryFrom  String?
  outstandingReceivable   Decimal @default(0) @db.Decimal(15, 2)
  outstandingPayable      Decimal @default(0) @db.Decimal(15, 2)
  isFinanciallyCleared    Boolean @default(false)

  // Bin
  isDeleted   Boolean   @default(false)
  deletedAt   DateTime?
  deletedById String?
  deletedBy   User?     @relation("ChallanDeletedBy", fields: [deletedById], references: [id], onDelete: SetNull)

  // Audit
  createdById String?
  createdBy   User?   @relation("ChallanCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  updatedById String?
  updatedBy   User?   @relation("ChallanUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  bilties            ChallanBilty[]
  settlementPayments SettlementPayment[]

  @@index([loadingDate])
  @@index([status])
  @@index([isDeleted, deletedAt])
  @@index([challanNo])
}

model ChallanBilty {
  id        String   @id @default(cuid())
  challanId String
  biltyId   String
  challan   Challan  @relation(fields: [challanId], references: [id], onDelete: Cascade)
  bilty     Bilty    @relation(fields: [biltyId], references: [id], onDelete: Cascade)
  addedAt   DateTime @default(now())

  @@unique([challanId, biltyId])
  @@index([biltyId])
}

// ============================================================
// SHOWROOM PHONCH / DELIVERY
//
// ANC's own delivery/clearing-agent document: a driver arrives with
// a Bilty/Challan issued by ANOTHER transporter's own system, and
// ANC records the vehicles delivered plus what it charges that
// Transporter for the delivery. Bilty No./Challan No. on each
// vehicle line are therefore plain manual reference text, never a
// foreign key - the referenced Bilty/Challan very often does not
// exist as a row in THIS database at all (it belongs to the sending
// transporter). Only the Transporter and each vehicle's optional
// Party are real ERP party/account references, exactly like every
// other document (see Bilty/Challan's own consignor/consignee/
// transporter fields).
//
// Accounting (see lib/phonch-accounting.ts): a single JournalEntry
// is created once at Phonch creation, referenceType "PHONCH",
// referenceId = this Phonch's id - Debit Transporter (the full
// Total Phonch Amount, establishing the receivable), Credit the
// appropriate income account(s) per component. Never a second
// JournalEntry per vehicle line. "Received" is NEVER stored here -
// it is always derived fresh from Daily Posting receipts tagged
// sourceType "PHONCH", sourceId = this Phonch's id (the exact same
// convention Bilty/Challan already use), mirroring
// lib/bilty-paid-verification.ts's getBiltyPaidVerification().
// ============================================================

model Phonch {
  id       String   @id @default(cuid())
  phonchNo String   @unique
  date     DateTime

  transporterPartyId String
  transporterParty   Party   @relation("PhonchTransporterParty", fields: [transporterPartyId], references: [id], onDelete: Restrict)
  carrierNumber      String?

  // Optional general Phonch description (Step 6) - deliberately
  // separate from each vehicle line's mandatory Other Expense/Claim
  // reason fields (see PhonchVehicle below).
  description String?

  vehicles PhonchVehicle[]

  // Bin
  isDeleted   Boolean   @default(false)
  deletedAt   DateTime?
  deletedById String?
  deletedBy   User?     @relation("PhonchDeletedBy", fields: [deletedById], references: [id], onDelete: SetNull)

  // Audit
  createdById String?
  createdBy   User?   @relation("PhonchCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  updatedById String?
  updatedBy   User?   @relation("PhonchUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([date])
  @@index([isDeleted, deletedAt])
  @@index([transporterPartyId])
}

model PhonchVehicle {
  id       String @id @default(cuid())
  phonchId String
  phonch   Phonch @relation(fields: [phonchId], references: [id], onDelete: Cascade)
  lineNo   Int

  // Manual reference text only - see the module doc comment above
  // for why these are never foreign keys.
  biltyNo   String?
  challanNo String?

  chassisNumber String?
  engineNumber  String?
  vehicleName   String?

  partyId String?
  party   Party?  @relation("PhonchVehicleParty", fields: [partyId], references: [id], onDelete: SetNull)

  deliveryCharges Decimal @default(0) @db.Decimal(15, 2)
  note            String?

  // Other Expense (Step 4) - amount and reason travel together;
  // resolvePhonchInput() (lib/phonch-accounting.ts) rejects a
  // nonzero amount with no reason, and vice versa.
  otherExpenseAmount Decimal @default(0) @db.Decimal(15, 2)
  otherExpenseReason String?

  // Claim (Step 5) - recorded against this specific vehicle line,
  // never a Phonch-level total entered directly.
  claimAmount Decimal @default(0) @db.Decimal(15, 2)
  claimReason String?

  createdAt DateTime @default(now())

  // Reverse Bill Book link (see model BillSourceLink below) - a vehicle
  // is billed by at most one ACTIVE Bill at a time (enforced at the
  // application level, never a hard DB constraint, so a binned Bill's
  // own link never permanently blocks re-billing the same vehicle).
  billSourceLinks BillSourceLink[]

  @@index([phonchId])
}

// ============================================================
// PRIVATE PHONCH - vehicle/rent settlement record.
//
// Distinct from Showroom Phonch above (a RECEIVABLE from a
// Transporter for delivery/handling charges ANC billed them): Private
// Phonch records a PAYABLE - Carrier Rent that ANC owes OUT to the
// Transporter (for actually carrying the vehicle) and, per vehicle,
// optionally to a Clearing Agent (their own share of that same rent -
// "amanat"). Bilty No./Challan No. on each vehicle line are, exactly
// like Showroom Phonch's own biltyNo/challanNo, plain manual
// reference text, NEVER a foreign key into this system's own
// Bilty/Challan tables - Private Phonch is a fully independent
// economic record. Linking it to a real Bilty/Challan row would risk
// double-recognizing that same Bilty/Challan's own, separate,
// Settlement-driven Carrier Rent and Collection accounting - a
// business decision confirmed explicitly, not inferred.
//
// Accounting (see lib/private-phonch-accounting.ts): a single
// JournalEntry is created once at creation, referenceType
// "PRIVATE_PHONCH", referenceId = this record's id - Debit the
// "Private Phonch Carrier Rent Expense" system account for the full
// sum of Total Rent across every vehicle line; Credit the Transporter
// for the sum of Carrier Payable, Credit each distinct Clearing Agent
// for the sum of CA Payable attributed to them, and Credit the
// "Private Phonch Delivery Income" system account for the sum of
// Delivery Charges - so Total Rent = Carrier Payable + CA Payable +
// Delivery Charges balances in one entry, exactly mirroring Showroom
// Phonch's own single-entry-at-creation shape. Never a second
// JournalEntry per vehicle line. Actual Cash/Bank payment to the
// Transporter/a Clearing Agent, or a Clearing Agent's own deposit
// receipt, happens ONLY through Daily Posting (sourceType
// "PRIVATE_PHONCH", sourceId = this record's id) - mirrored from
// lib/bilty-paid-verification.ts's getBiltyPaidVerification() /
// lib/phonch-accounting.ts's getPhonchPaymentState(), never stored
// here directly.
// ============================================================

model PrivatePhonch {
  id       String   @id @default(cuid())
  phonchNo String   @unique
  date     DateTime

  transporterPartyId String
  transporterParty   Party  @relation("PrivatePhonchTransporterParty", fields: [transporterPartyId], references: [id], onDelete: Restrict)

  // Bill Book link placeholder (Step 22 of the spec) - manual text,
  // set only by a future Bill Book feature via its own update path;
  // this task never writes it itself beyond leaving it null. Display-
  // only here.
  billNo String?

  vehicles PrivatePhonchVehicle[]

  // Bin
  isDeleted   Boolean   @default(false)
  deletedAt   DateTime?
  deletedById String?
  deletedBy   User?     @relation("PrivatePhonchDeletedBy", fields: [deletedById], references: [id], onDelete: SetNull)

  // Audit
  createdById String?
  createdBy   User?   @relation("PrivatePhonchCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  updatedById String?
  updatedBy   User?   @relation("PrivatePhonchUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([date])
  @@index([isDeleted, deletedAt])
  @@index([transporterPartyId])
}

model PrivatePhonchVehicle {
  id       String        @id @default(cuid())
  phonchId String
  phonch   PrivatePhonch @relation(fields: [phonchId], references: [id], onDelete: Cascade)
  lineNo   Int

  // Manual reference text only - see the module doc comment above.
  biltyNo   String?
  challanNo String?

  chassisNumber String?
  engineNumber  String?
  vehicleName   String?

  // Distinct per vehicle row - the SAME Clearing Agent may appear on
  // several rows of the same Private Phonch, and different rows may
  // each name a different Clearing Agent (Step 5 of the spec) -
  // deliberately NOT a single Private Phonch-level field.
  clearingAgentPartyId String?
  clearingAgentParty   Party?  @relation("PrivatePhonchVehicleClearingAgent", fields: [clearingAgentPartyId], references: [id], onDelete: SetNull)

  // Raw inputs only - Net Rent (totalRent - deliveryCharges) and CA
  // Payable (netRent - carrierPayable) are ALWAYS derived fresh, both
  // server-side (resolvePrivatePhonchInput()) and on every read,
  // exactly like Showroom Phonch's own totals are never trusted from
  // a stored, independently-editable column.
  totalRent       Decimal @default(0) @db.Decimal(15, 2)
  deliveryCharges Decimal @default(0) @db.Decimal(15, 2)
  carrierPayable  Decimal @default(0) @db.Decimal(15, 2)

  // Only meaningful when totalRent = 0 and deliveryCharges > 0 (a
  // fully-paid vehicle) - "TRANSPORTER" or "CLEARING_AGENT", who this
  // vehicle's Delivery Charges are recovered FROM. Null for every
  // normal (totalRent > 0) vehicle, where Delivery Charges are instead
  // absorbed into Net Rent/CA Payable exactly as before this field
  // existed. See lib/private-phonch-accounting.ts's own doc comment.
  deliveryRecoveryParty String?

  note String?

  createdAt DateTime @default(now())

  // Reverse Bill Book link - see the identical comment on
  // PhonchVehicle.billSourceLinks above.
  billSourceLinks BillSourceLink[]

  @@index([phonchId])
  @@index([clearingAgentPartyId])
}

// ============================================================
// BILL BOOK - client-side billing/receivable document.
//
// Distinct from Private Phonch/Showroom Phonch: those two record
// ANC's CARRIER-SIDE transaction (what ANC owes/earns from the
// Transporter for physically moving the vehicle - completely
// unchanged, untouched by Bill Book). A Bill records the separate
// CLIENT-SIDE transaction - the amount ANC actually charges the
// paying client (Rent + Delivery + Other Expense per vehicle), which
// is an independent, editable figure that merely defaults from the
// linked source vehicle's own numbers for convenience (see
// resolveBillInput() in lib/bill-accounting.ts) - it is NEVER
// structurally tied to the source's own Carrier Payable/CA Payable/
// Delivery Income figures. Billing the client for a different amount
// than what ANC pays the carrier (the margin) is the normal case, not
// an edge case.
//
// Accounting (lib/bill-accounting.ts): ONE JournalEntry per Bill,
// referenceType "BILL", referenceId = this Bill's id - Debit the
// Client Party (Bill Total, establishing their receivable) / Credit
// the dedicated "Bill Income" system account (lib/gross-accounts.ts's
// getBillIncomeAccountId()) - never Private/Showroom Phonch's own
// Carrier Rent Expense/Payable/Delivery Income accounts, which stay
// completely untouched. Actual client payment happens ONLY through
// Daily Posting (sourceType "BILL", sourceId = this Bill's id),
// mirrored from getPhonchPaymentState()'s exact shape - never stored
// here directly.
//
// ONE Bill = ONE client Party, and (Section 3) at most ONE source
// type across all its items - never mixed Private Phonch + Showroom
// Phonch on the same Bill. sourceType is null for a Manual Bill (no
// linked source vehicles at all).
// ============================================================

enum BillSourceType {
  PRIVATE_PHONCH
  SHOWROOM_PHONCH
}

model Bill {
  id     String   @id @default(cuid())
  billNo String   @unique
  date   DateTime

  // A Bill's client is EITHER an existing, explicitly-selected Party
  // (clientPartyId set, using that Party's own Account) OR a random/
  // one-time client typed by name only (clientPartyId left null) -
  // never a Party/Account transparently created just because a typed
  // name doesn't match an existing Party. A null-clientPartyId Bill's
  // accounting posts against the single shared "Bill Book - Walk-in
  // Customers" system account instead (see
  // lib/gross-accounts.ts's getBillWalkInReceivableAccountId() and
  // lib/bill-accounting.ts's resolveBillClientAccountId()) - each such
  // Bill's own payment state still resolves correctly and
  // independently, since getBillPaymentState() filters by sourceId
  // (this Bill's own id), never by accountId alone. clientName/
  // clientPhone are always the source of truth for display/search/
  // print (mirrors Bilty's own consignorName/consignorPhone pattern
  // alongside its optional consignorPartyId) - never a live re-read of
  // a selected Party's own (possibly since-changed) name/phone.
  clientPartyId String?
  clientParty   Party?  @relation("BillClientParty", fields: [clientPartyId], references: [id], onDelete: Restrict)
  clientName    String
  clientPhone   String?

  sourceType BillSourceType?

  items       BillItem[]
  sourceLinks BillSourceLink[]

  // Bin
  isDeleted   Boolean   @default(false)
  deletedAt   DateTime?
  deletedById String?
  deletedBy   User?     @relation("BillDeletedBy", fields: [deletedById], references: [id], onDelete: SetNull)

  // Audit
  createdById String?
  createdBy   User?   @relation("BillCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  updatedById String?
  updatedBy   User?   @relation("BillUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([clientPartyId])
  @@index([isDeleted, deletedAt])
  @@index([date])
}

model BillItem {
  id     String @id @default(cuid())
  billId String
  bill   Bill   @relation(fields: [billId], references: [id], onDelete: Cascade)
  lineNo Int

  // Only the fields Bill Book actually supports (Section 8) - never
  // the source document's full field set. Auto-populated from the
  // linked source vehicle when one exists, but always independently
  // editable raw inputs - see the model's own doc comment above.
  vehicleName   String?
  fromText      String?
  toText        String?
  engineNumber  String?
  chassisNumber String?
  regdNumber    String?

  // Raw inputs - Vehicle Total (rent + delivery + otherExpense) is
  // ALWAYS derived fresh server-side and on every read, exactly like
  // every other module's own vehicle-row total, never a stored column.
  rent         Decimal @default(0) @db.Decimal(15, 2)
  delivery     Decimal @default(0) @db.Decimal(15, 2)
  otherExpense Decimal @default(0) @db.Decimal(15, 2)

  sourceLink BillSourceLink?

  createdAt DateTime @default(now())

  @@index([billId])
}

model BillSourceLink {
  id     String @id @default(cuid())
  billId String
  bill   Bill   @relation(fields: [billId], references: [id], onDelete: Cascade)

  billItemId String   @unique
  billItem   BillItem @relation(fields: [billItemId], references: [id], onDelete: Cascade)

  sourceType BillSourceType

  // Exactly one of these two is set, matching the parent Bill's own
  // sourceType - never both, never neither (a BillItem with no source
  // link at all simply has no BillSourceLink row - a Manual Bill row).
  // onDelete: Restrict - a source vehicle that has ever been billed
  // can never be hard-deleted (nor can its parent Phonch/Private
  // Phonch be permanently deleted) while this link exists, protecting
  // the financial record exactly like every other linked-document
  // protection in this ERP.
  privatePhonchVehicleId String?
  privatePhonchVehicle   PrivatePhonchVehicle? @relation(fields: [privatePhonchVehicleId], references: [id], onDelete: Restrict)

  phonchVehicleId String?
  phonchVehicle   PhonchVehicle? @relation(fields: [phonchVehicleId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())

  @@index([billId])
  @@index([privatePhonchVehicleId])
  @@index([phonchVehicleId])
}

// ============================================================
// CENTRAL SETTINGS MODULE
//
// One authoritative BusinessSettings row for the entire ERP - business
// identity, branding file references, document header/footer
// configuration, invoice/bill preferences, and PDF/print defaults.
// Never a duplicate row: enforced at the application level exactly
// like this ERP's own system Account rows (lib/gross-accounts.ts's
// getOrCreateSystemAccount()) - lib/business-settings.ts's
// getBusinessSettings() always finds the existing row first, creating
// the very first one only if none exists yet, and every PATCH updates
// that SAME row by its own id - never a second insert.
//
// Purely a configuration source for FUTURE document generation - never
// touches JournalEntry/JournalLine, never rewrites an already-generated
// PDF, never affects any accounting calculation. Document generators
// are NOT rewired to consume this in this phase (see the module's own
// README-equivalent, the Final Report, for exactly which ones still
// need that follow-up integration).
//
// Branding images are stored on local disk under public/uploads/branding/
// (this project has no existing file-storage/S3-equivalent architecture
// to reuse - see app/api/settings/branding/upload/route.ts), with only
// the resulting stable /uploads/... URL saved on this row - never a
// binary blob in the database.
// ============================================================

enum LogoPosition {
  LEFT
  CENTER
  RIGHT
}

enum HeaderAlignment {
  LEFT
  CENTER
  RIGHT
}

enum PdfPageSize {
  A4
  A5
}

enum PdfOrientation {
  PORTRAIT
  LANDSCAPE
}

enum SettingsDocumentType {
  BILTY
  CHALLAN
  BILL
  PRIVATE_PHONCH
  SHOWROOM_PHONCH
  RECEIPT
  PARTY_STATEMENT
  REPORTS
}

model BusinessSettings {
  id String @id @default(cuid())

  // Real DB-level backstop against a second row ever existing - every
  // row has this exact same value, and the UNIQUE constraint means a
  // second concurrent INSERT fails outright (P2002) instead of quietly
  // succeeding as a duplicate. getBusinessSettings() (lib/business-
  // settings.ts) catches that failure and re-reads the row the OTHER
  // concurrent request just won, rather than assuming its own findFirst
  // (not atomic with the create that follows it) was race-free.
  singleton String @unique @default("SINGLETON")

  // ---- Business Details (Section 2) - all optional except the
  // business name itself, per "Optional fields must remain optional.
  // Do not invent mandatory tax/legal fields." ----
  businessName         String  @default("")
  legalName            String?
  shortName            String?
  phone1               String?
  phone2               String?
  whatsapp             String?
  email                String?
  website              String?
  address              String?
  city                 String?
  province             String?
  country              String?
  ntnNumber            String?
  registrationNumber   String?

  // ---- Branding (Section 3) - stable file references only, never
  // binary data. ----
  mainLogoUrl          String?
  smallLogoUrl         String?
  faviconUrl           String?
  signatureUrl         String?
  stampUrl             String?
  brandPrimaryColor    String?
  brandSecondaryColor  String?

  // ---- Header & Footer (Section 4) ----
  headerShowLogo         Boolean         @default(true)
  headerShowBusinessName Boolean         @default(true)
  headerShowAddress      Boolean         @default(true)
  headerShowPhone        Boolean         @default(true)
  headerShowWhatsapp     Boolean         @default(false)
  headerShowEmail        Boolean         @default(false)
  headerShowWebsite      Boolean         @default(false)
  headerLogoPosition     LogoPosition    @default(LEFT)
  headerAlignment        HeaderAlignment @default(CENTER)
  headerSubtitle         String?

  // Global fallback for a document type with no explicit
  // DocumentTypeSettings override (or no override row at all) - see
  // getDocumentTypeSettings() in lib/business-settings.ts, the one
  // place this fallback is actually resolved.
  defaultUseHeader Boolean @default(true)
  defaultUseFooter Boolean @default(true)
  defaultUseLogo   Boolean @default(true)

  footerText             String?
  footerShowPhone        Boolean @default(true)
  footerShowAddress      Boolean @default(false)
  footerShowWebsite      Boolean @default(false)
  footerShowPageNumber   Boolean @default(true)
  footerShowGeneratedDate Boolean @default(true)
  termsAndConditions     String?

  // ---- Invoice / Bill Settings (Section 6) - display/document
  // preferences only. Never a second Bill numbering system: Bill's own
  // billNo is still entered per-Bill exactly as today (see
  // lib/bill-accounting.ts) - invoiceNumberPrefix here is a purely
  // presentational default the Bill form MAY offer to pre-fill in a
  // future integration, never an authoritative counter of its own. ----
  invoiceTitle           String  @default("BILL")
  invoiceNumberPrefix    String?
  currencyLabel          String  @default("Rs.")
  paymentInstructions    String?
  defaultTermsAndConditions String?
  authorizedByLabel      String  @default("Authorized Signature")
  signatureLabel         String  @default("Signature")

  // ---- PDF & Print Settings (Section 7) ----
  pdfPageSize            PdfPageSize    @default(A4)
  pdfOrientation         PdfOrientation @default(PORTRAIT)
  pdfDefaultFont         String?
  pdfDefaultFontSize     Int            @default(10)
  pdfTableBorderStyle    String?
  pdfShowWatermark       Boolean        @default(false)
  pdfWatermarkText       String?
  pdfShowPageNumber      Boolean        @default(true)
  pdfShowGeneratedDate   Boolean        @default(true)

  documentTypeSettings DocumentTypeSettings[]

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  updatedById String?
  updatedBy   User?    @relation("BusinessSettingsUpdatedBy", fields: [updatedById], references: [id])
}

// Per-document-type override of the global header/footer/logo defaults
// above (Section 5) - one row per SettingsDocumentType, at most. A null
// field means "not explicitly configured, use the global
// BusinessSettings default" - see lib/business-settings.ts's
// getDocumentTypeSettings(), the single place this fallback is
// resolved (never re-derived per-caller).
model DocumentTypeSettings {
  id                 String               @id @default(cuid())
  businessSettingsId String
  businessSettings   BusinessSettings     @relation(fields: [businessSettingsId], references: [id], onDelete: Cascade)
  documentType       SettingsDocumentType

  useHeader Boolean?
  useFooter Boolean?
  useLogo   Boolean?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([businessSettingsId, documentType])
}

// ============================================================
// AUDIT LOG - append-only accountability trail (WHO/WHAT/WHEN/WHICH
// RECORD/OLD VALUE/NEW VALUE). A SECURITY + ACCOUNTABILITY layer,
// completely separate from and never a substitute for
// JournalEntry/JournalLine (the real accounting ledger) - writing an
// AuditLog row must never itself create accounting records, and a
// business action's own JournalEntry/JournalLine must never be
// skipped or altered because of audit logging.
//
// No relation to User is declared, on purpose: userId/
// userNameSnapshot/userRoleSnapshot are a point-in-time SNAPSHOT that
// must stay legible even if the User row is later renamed, has its
// role changed, or is removed - a live FK relation would let a rename
// silently rewrite history via Prisma's own relation resolution,
// exactly what this table must never do.
//
// `module`/`entityType` are deliberately plain Strings, matching this
// schema's own existing JournalEntry.referenceType / JournalLine.
// sourceType convention (see those fields' own comments) rather than
// a new enum vocabulary that would need a migration every time a new
// module gets audited. `action` IS a bounded, stable enum
// (AuditAction) - the same reasoning that already makes
// PartyType/AccountType/BillSourceType real enums in this schema.
//
// Rows are never updated or deleted by the application - see
// lib/audit-log.ts (the one place rows are ever written) and
// app/api/audit-log/route.ts (GET/list only - no PATCH/DELETE route
// exists for this model at all).
// ============================================================

enum AuditAction {
  CREATE
  UPDATE
  DELETE
  RESTORE
  POST
  PAYMENT
  RECEIPT
  SETTLEMENT
  SETTLEMENT_PAYMENT
  LOGIN_SUCCESS
  LOGIN_FAILED
  LOGOUT
  EXPORT
  SETTINGS_CHANGE
  PERMISSION_CHANGE
}

model AuditLog {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  // Snapshot, not a live relation - see this model's own doc comment
  // above for why.
  userId           String?
  userNameSnapshot String?
  userRoleSnapshot String?

  action     AuditAction
  module     String
  entityType String
  entityId   String?
  documentNo String?

  description String

  oldValues     Json?
  newValues     Json?
  changedFields Json?

  ipAddress String?
  userAgent String?
  requestId String?

  @@index([createdAt])
  @@index([userId])
  @@index([action])
  @@index([module])
  @@index([entityType, entityId])
  @@index([documentNo])
}
