# ANC ERP — environment variable template.
# Copy to .env and fill in real values. NEVER commit the real .env file
# (it is already gitignored via `.env*` in .gitignore).
#
# This file lists every environment variable the application code
# actually reads (verified via `grep -r process.env` across app/ and
# lib/) — nothing here is speculative.

# PostgreSQL connection string Prisma uses for both the running
# application (lib/prisma.ts) and the Prisma CLI (prisma.config.ts).
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL="postgresql://anc_erp:CHANGE_ME@127.0.0.1:5432/al_naeem_erp"

# Secret used to sign/verify the login session JWT (lib/auth.ts,
# app/api/auth/login/route.ts). The app throws at startup if this is
# missing — there is no fallback/default. Use a long, random value;
# rotating it invalidates every existing login session.
JWT_SECRET="CHANGE_ME_TO_A_LONG_RANDOM_VALUE"

# Standard Next.js environment flag. Must be "production" for a real
# deployment — this also controls whether the login cookie is marked
# Secure (HTTPS-only); see docs/PRODUCTION_DEPLOYMENT.md's SSL note.
NODE_ENV="production"

# Port `next start` listens on (Next.js reads PORT natively). Nginx's
# reverse-proxy template in this repo assumes 3000 — change both
# together if you use a different port.
PORT=3000
